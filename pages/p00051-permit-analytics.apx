    region permit-trend (
        name: Permit Trend
        type: chart
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent15
                t-Region--scrollBody
            ]
            icon: fa-line-chart
        }
        advanced {
            htmlDomId: p51-line-trend
        }
        chart {
            type: line
        }
        chartLayout {
            height: 280
        }
        legend {
            show: false
        }

        series total-permits (
            name: Total Permits
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        CASE :P51_TIME_GROUPING
                            WHEN 'DAILY'  THEN TO_CHAR(group_daily,   'DD-Mon-YYYY')
                            WHEN 'WEEKLY' THEN 'Wk ' || TO_CHAR(group_weekly, 'IW YYYY')
                            ELSE               TO_CHAR(group_monthly,  'Mon-YYYY')
                        END              AS period_label,
                        CASE :P51_TIME_GROUPING
                            WHEN 'DAILY'  THEN group_daily
                            WHEN 'WEEKLY' THEN group_weekly
                            ELSE               group_monthly
                        END              AS period_date,
                        COUNT(*)         AS permit_count
                    FROM ptw_pro.ptw_lv_analytics_v
                    GROUP BY
                        CASE :P51_TIME_GROUPING
                            WHEN 'DAILY'  THEN group_daily
                            WHEN 'WEEKLY' THEN group_weekly
                            ELSE               group_monthly
                        END,
                        CASE :P51_TIME_GROUPING
                            WHEN 'DAILY'  THEN TO_CHAR(group_daily,   'DD-Mon-YYYY')
                            WHEN 'WEEKLY' THEN 'Wk ' || TO_CHAR(group_weekly, 'IW YYYY')
                            ELSE               TO_CHAR(group_monthly,  'Mon-YYYY')
                        END
                    ORDER BY
                        CASE :P51_TIME_GROUPING
                            WHEN 'DAILY'  THEN group_daily
                            WHEN 'WEEKLY' THEN group_weekly
                            ELSE               group_monthly
                        END
                    ```
                pageItemsToSubmit: [
                    P51_TIME_GROUPING
                    " P51_WORKFLOW_STATUS"
                    P51_COMPANY
                    " P51_SITE_DETAILS"
                    P51_PERSON_IN_CHARGE
                    " P51_CREATED_DATE"
                    " P51_SEARCH"
                ]
            }
            columnMapping {
                label: PERIOD_LABEL
                value: PERMIT_COUNT
            }
            appearance {
                color: #4a9fd4
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region permits-by-company (
        name: Permits by Company
        title: Permits by Company
        type: chart
        layout {
            sequence: 70
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent15
                t-Region--scrollBody
            ]
            icon: fa-bar-chart
        }
        advanced {
            htmlDomId: p51-bar-company
        }
        chartLayout {
            height: 320
        }
        legend {
            show: false
        }

        series permits (
            name: Permits
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        company          AS label,
                        COUNT(*)         AS permit_count
                    FROM ptw_pro.ptw_lv_analytics_v
                    GROUP BY company
                    ORDER BY COUNT(*) DESC
                    FETCH FIRST 15 ROWS ONLY
                    ```
            }
            columnMapping {
                label: LABEL
                value: PERMIT_COUNT
            }
            appearance {
                color: #344b5c
            }
            link {
                type: redirectUrl
                targetUrl: javascript:p51DrillCompany('#LABEL#');
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region permits-by-status (
        name: Permits by Status
        title: Permits by Status
        type: chart
        layout {
            sequence: 80
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent15
                t-Region--scrollBody
            ]
            icon: fa-pie-chart
        }
        advanced {
            htmlDomId: p51-pie-status
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 320
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series status-breakdown (
            name: Status Breakdown
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        status_display   AS label,
                        workflow_status  AS status_val,
                        COUNT(*)         AS permit_count,
                        status_colour    AS series_color
                    FROM ptw_pro.ptw_lv_analytics_v
                    GROUP BY status_display, workflow_status, status_colour
                    ORDER BY COUNT(*) DESC
                    ```
            }
            columnMapping {
                label: LABEL
                value: PERMIT_COUNT
            }
            appearance {
                color: #SERIES_COLOR#
            }
            link {
                type: redirectUrl
                targetUrl: javascript:p51DrillStatus('#STATUS_VAL#');
            }
            label {
                show: true
            }
        )

    )

    pageItem P51_DRILL_COMPANY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            slot: body
        }
    )

    pageItem P51_DRILL_STATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            slot: body
        }
    )

    pageItem P51_TIME_GROUPING (
        type: selectList
        label {
            label: Group By
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Monthly;MONTHLY,Weekly;WEEKLY,Daily;DAILY
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @permit-trend
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: MONTHLY
        }
    )

    dynamicAction drill-company-refresh-report (
        name: Drill Company - Refresh Report
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P51_DRILL_COMPANY
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @analytics-results
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction drill-status-refresh-report (
        name: Drill Status - Refresh Report
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P51_DRILL_STATUS
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @analytics-results
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction facet-change-refresh-charts (
        name: Facet Change - Refresh Charts
        execution {
            sequence: 10
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @analytics-results
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: p51RefreshCharts();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction time-grouping-change (
        name: Time Grouping Change
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P51_TIME_GROUPING
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @permit-trend
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

