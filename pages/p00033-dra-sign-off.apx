page 33 (
    name: DRA Sign-off
    alias: DRA-SIGN-OFF
    title: DRA Sign-off
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var draSignaturePad;
            function ptwToggleNoReason() {
                var isNo = apex.item('P33_CAN_PROCEED').getValue() === 'NO';
                if (isNo) { apex.item('P33_NO_REASON').show(); } else { apex.item('P33_NO_REASON').hide(); }
            }
            ```
    }
    css {
        inline:
            ```css
            .declaration-box {
                background: var(--ut-palette-warning-light, #fff8e1);
                border-left: 4px solid var(--ut-palette-warning, #f0ad4e);
                padding: 1rem 1.25rem;
                border-radius: 0 6px 6px 0;
                margin-bottom: 1rem;
                font-size: 0.9rem;
                line-height: 1.5;
            }
            
            .signature-pad-container {
                border: 2px solid var(--ut-component-border-color, #d0d0d0);
                border-radius: 8px;
                background: #ffffff;
                padding: 10px;
                margin: 10px 0;
            }
            
            .signature-pad {
                width: 100%;
                height: 150px;
                border: 1px dashed #ccc;
                border-radius: 4px;
                touch-action: none;
                cursor: crosshair;
            }
            
            .signature-controls {
                display: flex;
                gap: 10px;
                margin-top: 10px;
                justify-content: flex-end;
            }
            
            .signature-controls button {
                padding: 6px 12px;
                border-radius: 4px;
                border: 1px solid #d0d0d0;
                background: #f5f5f5;
                cursor: pointer;
                font-size: 0.875rem;
            }
            
            .signature-controls button:hover {
                background: #e0e0e0;
            }
            
            ```
    }
    readOnly {
        type: item!=value
        item: P33_WORKFLOW_STATUS
        value: DRAFT
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region assessment (
        name: Assessment
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @proceed-safely
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region dra-number-type-badge (
        name: DRA Number / Type Badge
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="margin-bottom: 20px;">
                    <span class="apex-badge" style="background-color: #3ea055; color: white; padding: 6px 16px; border-radius: 20px; font-weight: 600;">
                        DRA: &P33_DRA_NUMBER.
                    </span>
                </div>
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P33_DRA_NUMBER
        }
    )

    region page-header (
        name: Page Header
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_html       CLOB;
                    l_company_id NUMBER;
                    l_logo_url   VARCHAR2(500);
                    l_logo_count NUMBER;
                    l_override   VARCHAR2(50) := V('G_OVERRIDE_COMPANY_ID');
                BEGIN
                    -- Derive effective company_id for the current user
                    IF l_override IS NOT NULL AND TRIM(l_override) IS NOT NULL THEN
                        BEGIN
                            l_company_id := TO_NUMBER(TRIM(l_override));
                        EXCEPTION
                            WHEN OTHERS THEN l_company_id := NULL;
                        END;
                    ELSE
                        -- Normal user: their own company
                        -- Super user with no override: NULL (no logo shown)
                        BEGIN
                            SELECT company_id
                            INTO   l_company_id
                            FROM   ptw_pro.ptw_lv_users
                            WHERE  UPPER(username) = UPPER(:APP_USER)
                            AND    is_super_user   = 'N'
                            AND    is_active       = 'Y';
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN l_company_id := NULL;
                        END;
                    END IF;
                 
                    -- Check if a logo file exists for this company
                    -- (graceful fallback - no broken image if file missing)
                 
                    IF l_company_id IS NOT NULL THEN
                        SELECT COUNT(*) INTO l_logo_count
                        FROM   apex_application_static_files
                        WHERE  application_id = :APP_ID
                        AND    file_name      = 'logo_' || l_company_id || '.png';
                 
                        IF l_logo_count > 0 THEN
                            l_logo_url := V('APP_FILES') || 'logo_' || l_company_id || '.png';
                        END IF;
                    END IF;
                 
                    -- Build header
                    l_html := '<div style="margin-bottom:30px;display:flex;'
                           || 'justify-content:space-between;align-items:center;'
                           || 'min-height:80px;">'
                           || '  <div>'
                           || '    <h1 style="font-size:2rem;color:#13294b;'
                           || '               margin-bottom:5px;">'
                           || '      New Dynamic Risk Assessment'
                           || '    </h1>'
                           || '    <p style="color:#666;font-size:1rem;">'
                           || '      Step 3 of 3 - Can I Proceed Safely?'
                           || '    </p>'
                           || '  </div>';
                 
                    IF l_logo_url IS NOT NULL THEN
                        l_html := l_html
                               || '  <div style="width:200px;height:60px;display:flex;'
                               || 'align-items:center;justify-content:flex-end;">'
                               || '    <img src="' || l_logo_url || '" '
                               || '         alt="Company Logo" '
                               || '         style="max-width:100%;max-height:100%;'
                               || 'object-fit:contain;" />'
                               || '  </div>';
                    END IF;
                 
                    l_html := l_html || '</div>';
                 
                    RETURN l_html;
                 
                EXCEPTION
                    WHEN OTHERS THEN
                        -- Never break Page 12 - fall back to plain header
                        RETURN '<div style="margin-bottom:30px;">'
                            || '<h1 style="font-size:2rem;color:#13294b;">'
                            || 'Dynamic Risk Assessment</h1>'
                            || '<p style="color:#666;">Step 3 of 3 - Can I Proceed Safely? ';
                            
                END;
                
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region proceed-safely (
        name: Proceed Safely
        title: Stage 3 - Can the work proceed  safely?
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="declaration-box">
                  Having completed Stage 1 and identified the hazards and controls in
                  Stage 2, I confirm my assessment below. If the answer is
                  <strong>No</strong>, the work must not proceed and I will record why
                  and inform my supervisor.
                </div>
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent10
                t-Region--scrollBody
            ]
            icon: fa-check-square-o
        }
    )

    region signature (
        name: Signature
        title: Signature
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="signature-pad-container">
                  <canvas id="draSignaturePad" class="signature-pad"></canvas>
                  <div class="signature-controls">
                   <button type="button" id="BTN_CLEAR_DRA_SIG"
                            onclick="if (draSignaturePad) { draSignaturePad.clear(); apex.item('P33_SIGNATURE_DATA').setValue(''); }">
                     Clear</button>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P33_CAN_PROCEED (
        type: radioGroup
        label {
            label: Can the work proceed safely?
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Yes;Y,No;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @assessment
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: cm-binary-item
        }
    )

    pageItem P33_DRA_ID (
        type: hidden
        layout {
            sequence: 30
            slot: body
        }
    )

    pageItem P33_DRA_NUMBER (
        type: hidden
        layout {
            sequence: 50
            slot: body
        }
    )

    pageItem P33_NO_REASON (
        type: textarea
        label {
            label: Why must the work not proceed?
            alignment: left
        }
        layout {
            sequence: 30
            region: @assessment
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            maxLength: 1000
        }
    )

    pageItem P33_SIGNATURE_DATA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            slot: body
        }
    )

    pageItem P33_SIGNATURE_NAME (
        type: displayOnly
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 10
            region: @signature
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P33_WORKFLOW_STATUS (
        type: hidden
        layout {
            sequence: 40
            slot: body
        }
    )

    button back (
        buttonName: BACK
        label: Back
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
                items: {
                    P13_DRA_ID: &P33_DRA_ID.
                }
                clearCache: 13
            }
        }
    )

    button complete-dra_1 (
        buttonName: COMPLETE_DRA
        label: Complete & Sign
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: BTN_COMPLETE_DRA
        }
        serverSideCondition {
            type: item=value
            item: P33_WORKFLOW_STATUS
            value: DRAFT
        }
    )

    button done (
        buttonName: DONE
        label: Back to DRAs
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: 11
            }
        }
        serverSideCondition {
            type: item!=value
            item: P33_WORKFLOW_STATUS
            value: DRAFT
        }
    )

    dynamicAction click-complete (
        name: Click Complete
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @complete-dra_1
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.message.clearErrors();
                    var sig = draSignaturePad ? draSignaturePad.getDataURL() : '';
                    if (!sig) {
                        apex.message.showErrors([{ type: 'error', location: 'page',
                                                   message: 'Please sign before completing the DRA.', unsafe: false }]);
                    } else {
                        apex.item('P33_SIGNATURE_DATA').setValue(sig);
                        var msg = apex.item('P33_CAN_PROCEED').getValue() === 'N'
                            ? 'Complete this DRA with the answer NO? The work must not proceed.'
                            : 'Complete and sign this DRA? It cannot be changed afterwards.';
                        apex.message.confirm(msg, function (ok) {
                            if (ok) { captureLocationThenSubmit('COMPLETE_DRA'); }
                        });
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction on-page-load (
        name: On Page Load
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var isReadOnly = apex.item('P33_WORKFLOW_STATUS').getValue() !== 'DRAFT';
                     
                    initPad('draSignaturePad', 'P33_SIGNATURE_DATA', function (pad) { draSignaturePad = pad; });
                     
                    // Binary Y/N badges - same pattern as Pages 16 / 24 (ptw-global.css styles)
                    (function () {
                        var BINARY_ITEMS = ['P33_CAN_PROCEED'];
                        var BADGES = [
                            { val: 'Y', cls: 'binary-badge-yes', label: '\u2713' },
                            { val: 'N', cls: 'binary-badge-no',  label: '\u2717' }
                        ];
                     
                        BINARY_ITEMS.forEach(function (itemName) {
                            var $fc = $('#' + itemName).closest('.t-Form-fieldContainer');
                            if ($fc.length === 0) return;
                            $fc.find('.binary-badge-row').remove();
                     
                            var currentVal = isReadOnly
                                ? (apex.item(itemName).getValue() || '')
                                : ($('input[name="' + itemName + '"]:checked').val() || '');
                     
                            var $row = $('<div class="binary-badge-row"></div>').attr('data-item', itemName);
                            BADGES.forEach(function (b) {
                                $('<span></span>')
                                    .addClass('binary-badge ' + b.cls)
                                    .toggleClass('cm-active', currentVal === b.val)
                                    .toggleClass('binary-readonly', isReadOnly)
                                    .attr('data-value', b.val)
                                    .text(b.label)
                                    .appendTo($row);
                            });
                            $fc.find('.t-Form-inputContainer').append($row);
                        });
                     
                        $('.cm-binary-item .apex-item-grid').hide();
                     
                        $(document).off('click.binarybadge33').on('click.binarybadge33', '.binary-badge:not(.binary-readonly)', function () {
                            var $badge   = $(this);
                            var $row     = $badge.closest('.binary-badge-row');
                            var itemName = $row.attr('data-item');
                            var val      = $badge.attr('data-value');
                     
                            // .trigger('change') also fires the "Toggle No Reason" DA
                            $('input[name="' + itemName + '"][value="' + val + '"]')
                                .prop('checked', true).trigger('change');
                     
                            $row.find('.binary-badge').removeClass('cm-active');
                            $badge.addClass('cm-active');
                        });
                    }());
                     
                    if (isReadOnly) {
                        var c = document.getElementById('draSignaturePad');
                        if (c) { c.style.pointerEvents = 'none'; c.style.opacity = '0.6'; }
                        $('#BTN_CLEAR_DRA_SIG').hide();
                    }
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction show-no-reason (
        name: Show No Reason
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P33_CAN_PROCEED
        }
        clientSideCondition {
            type: item=value
            item: P33_CAN_PROCEED
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P33_NO_REASON
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P33_NO_REASON
            }
            execution {
                sequence: 10
            }
        )

    )

    validation reason-required-when-no (
        name: Reason Required When No
        execution {
            sequence: 20
        }
        validation {
            language: sql
            sqlExpression: NOT (:P33_CAN_PROCEED = 'N' AND TRIM(:P33_NO_REASON) IS NULL)
        }
        error {
            errorMessage: Record why the work must not proceed.
            associatedItem: @P33_NO_REASON
        }
        serverSideCondition {
            whenButtonPressed: @complete-dra_1
        }
    )

    validation signature-required (
        name: Signature Required
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P33_SIGNATURE_DATA
        }
        error {
            errorMessage: A Signature is required.
        }
        serverSideCondition {
            whenButtonPressed: @complete-dra_1
        }
    )

    validation stage-3-answer-required (
        name: Stage 3 Answer Required
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P33_CAN_PROCEED
        }
        error {
            errorMessage:
                ```
                You must answer if you can proceed.
                
                ```
        }
        serverSideCondition {
            whenButtonPressed: @complete-dra_1
        }
    )

    process complete-dra (
        name: Complete DRA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    ptw_pro.ptw_dra_pkg.complete_dra(
                        p_dra_id         => :P33_DRA_ID,
                        p_can_proceed    => CASE :P33_CAN_PROCEED WHEN 'Y' THEN 'YES'
                                                                  WHEN 'N' THEN 'NO' END,
                        p_no_reason      => :P33_NO_REASON,
                        p_signature_name => :P33_SIGNATURE_NAME,
                        p_signature_b64  => :P33_SIGNATURE_DATA,
                        p_latitude       => TO_NUMBER(:APP_LATITUDE),
                        p_longitude      => TO_NUMBER(:APP_LONGITUDE));
                    apex_application.g_print_success_message :=
                        CASE :P33_CAN_PROCEED
                            WHEN 'N'  THEN 'DRA ' || :P33_DRA_NUMBER || ' completed - work must NOT proceed.'
                            ELSE 'DRA ' || :P33_DRA_NUMBER || ' completed.'
                        END;
                EXCEPTION
                    WHEN OTHERS THEN
                        ROLLBACK;
                        apex_error.add_error(
                            p_message          => REGEXP_REPLACE(SQLERRM, '^ORA-\d+: '),
                            p_display_location => apex_error.c_inline_in_notification);
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 56989521421385711
        }
        serverSideCondition {
            whenButtonPressed: @complete-dra_1
        }
    )

    process load-dra-sign-off (
        name: Load DRA Sign-off
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_sig        BLOB;
                    l_created_by ptw_pro.ptw_lv_dra_assessments.created_by%TYPE;
                BEGIN
                    IF :P33_DRA_ID IS NULL THEN
                        apex_util.redirect_url(apex_page.get_url(p_page => 11));
                    END IF;
                 
                    SELECT dra_number, workflow_status,
                           CASE stage3_can_proceed WHEN 'YES' THEN 'Y' WHEN 'NO' THEN 'N' END,
                           stage3_no_reason, signature_person_name, signature, created_by
                    INTO   :P33_DRA_NUMBER, :P33_WORKFLOW_STATUS, :P33_CAN_PROCEED, :P33_NO_REASON,
                           :P33_SIGNATURE_NAME, l_sig, l_created_by
                    FROM   ptw_pro.ptw_lv_dra_assessments
                    WHERE  dra_id = :P33_DRA_ID;
                 
                    IF :P33_WORKFLOW_STATUS = 'DRAFT' THEN
                        BEGIN
                            SELECT TRIM(first_name || ' ' || last_name)
                            INTO   :P33_SIGNATURE_NAME
                            FROM   ptw_pro.ptw_lv_users
                            WHERE  UPPER(username) = UPPER(l_created_by);
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN :P33_SIGNATURE_NAME := l_created_by;
                        END;
                    ELSIF l_sig IS NOT NULL THEN
                        :P33_SIGNATURE_DATA := 'data:image/png;base64,' || apex_web_service.blob2clobbase64(l_sig);
                    END IF;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        apex_util.redirect_url(apex_page.get_url(p_page => 11));
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 56988793224385703
        }
    )

    branch (
        name: Back to page 11
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 11
                clearCache: 11
            }
        }
        serverSideCondition {
            whenButtonPressed: @complete-dra_1
        }
    )

)

