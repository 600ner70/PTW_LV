            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 70
            }
        )

    )

    region super-user-current-company (
        name: Super User Current Company
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_override  VARCHAR2(50) := V('G_OVERRIDE_COMPANY_ID');
                    v_name      VARCHAR2(200);
                    v_html      CLOB;
                BEGIN
                    IF v_override IS NULL OR v_override = '' THEN
                        RETURN NULL;
                    END IF;
                
                    SELECT company_name
                    INTO   v_name
                    FROM   ptw_pro.ptw_lv_companies
                    WHERE  company_id = TO_NUMBER(v_override);
                
                    v_html := '<p><strong>Switched to Company: </strong>' 
                           || apex_escape.html(v_name) || '</p>';
                
                    RETURN v_html;
                
                EXCEPTION
                    WHEN OTHERS THEN RETURN NULL;
                END;
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_is_super VARCHAR2(1);
                BEGIN
                    SELECT is_super_user INTO v_is_super
                    FROM   ptw_pro.ptw_lv_users
                    WHERE  UPPER(username) = UPPER(:APP_USER)
                    AND    is_active = 'Y';
                    RETURN v_is_super = 'Y';
                EXCEPTION
                    WHEN OTHERS THEN RETURN FALSE;
                END;
                ```
        }
    )

