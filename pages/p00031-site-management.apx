page 31 (
    name: Site Management
    alias: SITE-MANAGEMENT
    title: Site Management
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .admin-page-header {
                background: linear-gradient(135deg, #003366 0%, #005599 100%);
                color: white;
                padding: 25px 30px;
                border-radius: 8px;
                margin-bottom: 25px;
            }
            .admin-page-header h1 { margin: 0 0 5px 0; font-size: 1.75rem; font-weight: 700; }
            .admin-page-header p  { margin: 0; opacity: 0.85; font-size: 0.95rem; }
            ```
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region page-header (
        name: Page Header
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_html CLOB;
                BEGIN
                    l_html := '<div class="admin-page-header">'
                           || '  <h1>Site Management</h1>'
                           || '  <p>Manage sites within your company and raise permits on them.</p>'
                           || '</div>';
                    RETURN l_html;
                END;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region teams (
        name: Sites
        title: Sites
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                  SELECT s.site_id,
                         s.site_name,
                         CASE s.is_active WHEN 'Y' THEN 'Active' ELSE 'Inactive' END AS status,
                         s.is_active,
                         (SELECT COUNT(*) FROM ptw_pro.ptw_lv_permits p
                           WHERE p.site_id = s.site_id)             AS permit_count,
                         TO_CHAR(s.created_date, 'DD-MON-YYYY HH24:MI') AS created_date,
                         s.created_by,
                         TO_CHAR(s.modified_date, 'DD-MON-YYYY HH24:MI') AS modified_date,
                         s.modified_by
                  FROM   ptw_pro.ptw_lv_sites s
                  ORDER  BY s.site_name
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 62142339392885563
        }

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column CREATED_DATE (
            type: plainText
            heading {
                heading: Created Date
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column IS_ACTIVE (
            type: plainText
            heading {
                heading: Is Active
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column MODIFIED_BY (
            type: plainText
            heading {
                heading: Modified By
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column MODIFIED_DATE (
            type: plainText
            heading {
                heading: Modified Date
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column PERMIT_COUNT (
            type: plainText
            heading {
                heading: Permit Count
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column SITE_ID (
            type: link
            heading {
                heading: Edit
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            link {
                target: {
                    page: 32
                    items: {
                        P32_SITE_ID: #SITE_ID#
                    }
                    clearCache: 32
                }
                linkText: <span class="fa fa-edit" title="Edit"></span>
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column SITE_NAME (
            type: plainText
            heading {
                heading: Site Name
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Sites
        }

        savedReport 531639 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATED_BY (
                sequence: 7
            )

            displayColumn CREATED_DATE (
                sequence: 6
            )

            displayColumn IS_ACTIVE (
                sequence: 4
            )

            displayColumn MODIFIED_BY (
                sequence: 9
            )

            displayColumn MODIFIED_DATE (
                sequence: 8
            )

            displayColumn PERMIT_COUNT (
                sequence: 5
            )

            displayColumn SITE_ID (
                sequence: 1
            )

            displayColumn SITE_NAME (
                sequence: 2
            )

            displayColumn STATUS (
                sequence: 3
            )

        )

    )

    pageItem P31_SITE_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            slot: body
        }
    )

    button create (
        buttonName: CREATE
        label: Create Site
        layout {
            sequence: 10
            region: @teams
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-users
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 32
                clearCache: 32
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

