page 29 (
    name: Edit Team
    alias: EDIT-TEAM
    title: Edit Team
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            (function () {
                var BINARY_ITEMS = ['P29_IS_ACTIVE'];
            
                var BADGES = [
                    { val: 'Y', cls: 'binary-badge-yes', label: '✓' },
                    { val: 'N', cls: 'binary-badge-no',  label: '✗' }
                ];
            
                BINARY_ITEMS.forEach(function (itemName) {
                    var $fc = $('#' + itemName).closest('.t-Form-fieldContainer');
                    if ($fc.length === 0) return;
            
                    $fc.find('.binary-badge-row').remove();
            
                    var currentVal = $('input[name="' + itemName + '"]:checked').val() || '';
            
                    var $row = $('<div class="binary-badge-row"></div>').attr('data-item', itemName);
            
                    BADGES.forEach(function (b) {
                        $('<span></span>')
                            .addClass('binary-badge ' + b.cls)
                            .toggleClass('cm-active', currentVal === b.val)
                            .attr('data-value', b.val)
                            .text(b.label)
                            .appendTo($row);
                    });
            
                    $fc.find('.t-Form-inputContainer').append($row);
                });
            
                $('.cm-binary-item .apex-item-grid').hide();
            
                $(document).off('click.binarybadge24').on('click.binarybadge24', '.binary-badge:not(.binary-readonly)', function () {
                    var $badge   = $(this);
                    var $row     = $badge.closest('.binary-badge-row');
                    var itemName = $row.attr('data-item');
                    var val      = $badge.attr('data-value');
            
                    $('input[name="' + itemName + '"][value="' + val + '"]')
                        .prop('checked', true).trigger('change');
            
                    $row.find('.binary-badge').removeClass('cm-active');
                    $badge.addClass('cm-active');
                });
            }());
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region edit-team (
        name: Edit Team
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region team-permit-types (
        name: Team Permit Types
        title: Team Permit Types
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ct.type_id,
                       pt.type_desc,
                       NVL(tt.is_active, 'INHERIT') AS current_setting
                FROM   ptw_pro.ptw_lv_company_types ct
                JOIN   ptw_pro.ptw_types pt ON pt.type_id = ct.type_id
                LEFT JOIN ptw_pro.ptw_lv_team_types tt
                       ON tt.team_id = :P29_TEAM_ID AND tt.type_id = ct.type_id
                WHERE  ct.is_active = 'Y'
                ORDER  BY pt.type_desc
                
                ```
            pageItemsToSubmit: P29_TEAM_ID
        }
        layout {
            sequence: 10
            parentRegion: @edit-team
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent15
                t-Region--scrollBody
            ]
            icon: fa-clipboard-list
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P29_TEAM_ID
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column CURRENT_SETTING (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Current Setting
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column TYPE_DESC (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Type Desc
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column TYPE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

    )

    pageItem P29_COMPANY_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P29_CREATED_DATE (
        type: displayOnly
        label {
            label: Created Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @edit-team
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: DD-MON-YYYY HH24:MI:SS
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P29_TEAM_ID
        }
    )

    pageItem P29_ENGINEER_COUNT (
        type: displayOnly
        label {
            label: Engineer Count
            alignment: left
        }
        layout {
            sequence: 50
            region: @edit-team
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P29_TEAM_ID
        }
        help {
            inlineHelpText: Number of engineers currently assigned
        }
    )

    pageItem P29_IS_ACTIVE (
        type: radioGroup
        label {
            label: Is Active
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Active;Y,Inactive;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @edit-team
            slot: regionBody
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            cssClasses: cm-binary-item
        }
    )

    pageItem P29_TEAM_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @edit-team
            slot: regionBody
        }
    )

    pageItem P29_TEAM_NAME (
        type: textField
        label {
            label: Team Name
            alignment: left
        }
        layout {
            sequence: 20
            region: @edit-team
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 27
                clearCache: 27
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 20
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation company-required-for-super-user (
        name: Company required for Super User
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                    IF :P29_COMPANY_ID IS NULL THEN
                        RETURN 'Unable to determine which company this team belongs to. '
                            || 'If you are a Super User, please select an Active Company '
                            || '(Admin > Set Active Company) before creating a team.';
                    END IF;
                    RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation team-name-must-be-unique (
        name: Team name must be unique
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_count NUMBER;
                BEGIN
                    SELECT COUNT(*) INTO v_count
                    FROM   ptw_pro.ptw_lv_teams
                    WHERE  UPPER(team_name) = UPPER(:P29_TEAM_NAME)
                    AND    company_id = :P29_COMPANY_ID
                    AND    (team_id != :P29_TEAM_ID OR :P29_TEAM_ID IS NULL);
                
                    IF v_count > 0 THEN
                        RETURN 'This Team Name is already in use for this company. Please choose a different name.';
                    END IF;
                END;
                ```
        }
        error {
            associatedItem: @P29_TEAM_NAME
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation team-name-required (
        name: Team name required
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P29_TEAM_NAME
        }
        error {
            errorMessage:
                ```
                Team name is mandatory.
                
                ```
            associatedItem: @P29_TEAM_NAME
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process load-data (
        name: Load data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                SELECT team_name,
                       is_Active,
                       company_id,
                       created_date
                INTO   :P29_TEAM_NAME,
                       :P29_IS_ACTIVE,
                       :P29_COMPANY_ID,
                       :P29_CREATED_DATE
                FROM   ptw_pro.ptw_lv_teams
                WHERE  team_id = :P29_TEAM_ID;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 53189108372153115
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P29_TEAM_ID
        }
    )

    process save-team (
        name: Save Team
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P29_TEAM_ID IS NULL THEN
                
                        -- CREATE: company_id comes from P29_COMPANY_ID, resolved earlier by
                        -- "Determine Effective Company" and guaranteed NOT NULL by the
                        -- "Company Required for Super User" validation before we ever get here.
                        INSERT INTO ptw_pro.ptw_lv_teams (company_id, team_name, is_active)
                        VALUES (:P29_COMPANY_ID, :P29_TEAM_NAME, :P29_IS_ACTIVE)
                        RETURNING team_id INTO :P29_TEAM_ID;
                
                    ELSE
                
                        -- UPDATE: company_id is intentionally NOT in the SET list.
                        -- A team's company is fixed at creation; this form has no control
                        -- to reassign it, and the VPD policy's update_check would reject
                        -- a cross-company UPDATE attempt anyway.
                        UPDATE ptw_pro.ptw_lv_teams
                        SET    team_name     = :P29_TEAM_NAME,
                               is_active     = :P29_IS_ACTIVE,
                               modified_date = SYSTIMESTAMP,
                               modified_by   = :APP_USER
                        WHERE  team_id = :P29_TEAM_ID;
                
                    END IF;
                
                EXCEPTION
                    WHEN DUP_VAL_ON_INDEX THEN
                        -- Belt-and-braces: UQ_PTW_LV_TEAMS (company_id, team_name) catches
                        -- any race condition the app-level uniqueness validation missed
                        -- (e.g. two concurrent saves). Same friendly message either way.
                        apex_error.add_error(
                            p_message          => 'This Team Name is already in use for this company. Please choose a different name.',
                            p_display_location => apex_error.c_inline_in_notification);
                
                    WHEN OTHERS THEN
                        apex_error.add_error(
                            p_message          => 'Unable to save team: ' || SQLERRM,
                            p_display_location => apex_error.c_inline_in_notification);
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 53156211220466131
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process super-user-check (
        name: Super User check
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    SELECT CASE
                               WHEN is_super_user = 'Y' AND (V('G_OVERRIDE_COMPANY_ID') IS NULL OR V('G_OVERRIDE_COMPANY_ID') = '')
                                   THEN NULL
                               WHEN is_super_user = 'Y'
                                   THEN TO_NUMBER(V('G_OVERRIDE_COMPANY_ID'))
                               ELSE company_id
                           END
                    INTO :P29_COMPANY_ID
                    FROM ptw_pro.ptw_lv_users
                    WHERE UPPER(username) = UPPER(:APP_USER) AND is_active = 'Y';
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN :P29_COMPANY_ID := NULL;
                END;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 53189921635153123
        }
        serverSideCondition {
            type: itemIsNull
            item: P29_TEAM_ID
        }
    )

    branch (
        name: Return to page 27
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 27
                items: {
                    P27_TEAM_ID: &P29_TEAM_ID.
                }
                clearCache: 27
                successMessage: false
            }
        }
    )

)

