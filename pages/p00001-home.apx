            type: requestIsContainedInValue
            value: DELETE_PERMIT
        }
    )

    branch (
        name: Reload Dashboard
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 1
                clearCache: 1
                successMessage: false
            }
        }
        serverSideCondition {
            type: request=Value
            value: CLEAR_OVERRIDE
        }
    )

)

