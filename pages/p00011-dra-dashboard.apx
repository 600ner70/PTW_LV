                    <div class="ptw-permit-card #CARD_COLOR_CLASS#">
                     
                      <div class="ptw-card-header">
                        <span class="ptw-card-permit-number">#DRA_NUMBER#</span>
                        <span class="t-Badge #BADGE_CLASS# t-Badge--lg">#STATUS_DISPLAY#</span>
                      </div>
