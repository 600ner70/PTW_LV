    pageItem P11_CANCEL_REASON (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            slot: body
        }
    )

    pageItem P11_SELECTED_DRA_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            slot: body
        }
    )

    button create-dra (
        buttonName: CREATE_DRA
        label: Create New DRA
        layout {
            sequence: 10
            region: @quick-actions
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa fa-plus-circle
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 12
                items: {
                    P12_WORKFLOW_STATUS: DRAFT
                }
                clearCache: 12
            }
        }
    )

    process cancel-dra (
        name: Cancel DRA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_dra_id ptw_pro.ptw_lv_dra_assessments.dra_id%TYPE := :P11_SELECTED_DRA_ID;
                BEGIN
                    ptw_pro.ptw_dra_pkg.cancel_dra(
                        p_dra_id => l_dra_id,
                        p_reason => :P11_CANCEL_REASON
                    );
                    apex_util.set_session_state('P11_SELECTED_DRA_ID', NULL);
                    apex_util.set_session_state('P11_CANCEL_REASON', NULL);
                EXCEPTION
                    WHEN OTHERS THEN
                        apex_error.add_error(
                            p_message          => SQLERRM,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                END;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: DRA cancelled.
        }
        advanced {
            executionMappingIdentifier: 43992168029819421
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST like 'CANCEL_DRA_%'
        }
    )

)

