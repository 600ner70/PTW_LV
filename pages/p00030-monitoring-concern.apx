    validation at-least-1-photo-required-below (
        name: At least 1 photo required (below)
        execution {
            sequence: 60
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_count NUMBER;
                BEGIN
                    IF :P30_HAPPY_TO_CONTINUE != 'N' THEN
                        RETURN TRUE;
                    END IF;
                
                    SELECT COUNT(*)
                    INTO   l_count
                    FROM   ptw_pro.ptw_lv_permit_photos
                    WHERE  concern_id = :P30_CONCERN_ID;
                
                    RETURN l_count > 0;
                END;
                ```
        }
        error {
            errorMessage: At least one photo of the issue is required before this concern can be signed off.
        }
        serverSideCondition {
            whenButtonPressed: @BTN_SIGN_CONCERN_P30
        }
    )

