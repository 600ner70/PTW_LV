    dynamicAction show-hide-it-permission-question (
        name: Show/Hide IT Permission Question
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P2_AFFECTS_IT_SYSTEMS
        }
        clientSideCondition {
            type: item=value
            item: P2_AFFECTS_IT_SYSTEMS
            value: Y
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P2_IT_PERMISSION_GRANTED
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
            clientSideCondition {
                type: item=value
                item: P2_AFFECTS_IT_SYSTEMS
                value: N
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P2_IT_PERMISSION_GRANTED
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: item=value
                item: P2_AFFECTS_IT_SYSTEMS
                value: Y
            }
        )

    )

