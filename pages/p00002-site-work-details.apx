page 2 (
    name: Site & Work Details
    alias: SITE-WORK-DETAILS
    title: Site & Work Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
