            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                items: {
                    P1_PERMIT_ID: &P2_PERMIT_ID.
                }
                clearCache: 2
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: BTN_CANCEL_P2
        }
    )

