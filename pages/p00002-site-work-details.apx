    readOnly {
        type: expression
        plsqlExpression:
            ```plsql
            :P2_WORKFLOW_STATUS != 'DRAFT'
            OR ptw_pro.ptw_lv_is_contract_support(V('APP_USER')) = 'Y'
            ```
