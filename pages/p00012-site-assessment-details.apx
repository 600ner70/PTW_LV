page 12 (
    name: Site & Assessment Details
    alias: SITE-ASSESSMENT-DETAILS
    title: Site & Assessment Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function ptwToggleSupervisingCompany() {
                var isSub = apex.item('P12_DRA_TYPE').getValue() === 'SUBCONTRACTOR';
                $('#P12_SUPERVISING_COMPANY_CONTAINER, [id*="P12_SUPERVISING_COMPANY"]')
                    .closest('.t-Form-fieldContainer').toggle(isSub);
            }
            ```
    }
    css {
        inline:
            ```css
            .ptw-dra-category {
                font-weight: 700;
                font-size: 0.9rem;
                color: #003366;
                text-transform: uppercase;
                letter-spacing: 0.03em;
                margin: 1.25rem 0 0.5rem 0;
                padding-bottom: 0.35rem;
                border-bottom: 2px solid var(--ut-palette-neutral-300, #d0d0d0);
            }
            .ptw-dra-category:first-child { margin-top: 0; }
            
            ```
    }
    readOnly {
        type: item!=value
        item: P12_WORKFLOW_STATUS
        value: DRAFT
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region assessment-details (
        name: Assessment Details
        title: Assessment Details
        type: staticContent
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent12
                t-Region--scrollBody
            ]
            icon: fa-clipboard
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 120
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region dra-number-type-badge (
        name: DRA Number / Type Badge
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="margin-bottom: 20px;">
                    <span class="apex-badge" style="background-color: #3ea055; color: white; padding: 6px 16px; border-radius: 20px; font-weight: 600;">
                        DRA: &P12_DRA_NUMBER.
                    </span>
                </div>
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P12_DRA_NUMBER
        }
    )

    region page-header (
        name: Page Header
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_html       CLOB;
                    l_company_id NUMBER;
                    l_logo_url   VARCHAR2(500);
                    l_logo_count NUMBER;
                    l_override   VARCHAR2(50) := V('G_OVERRIDE_COMPANY_ID');
                BEGIN
                    -- Derive effective company_id for the current user
                    IF l_override IS NOT NULL AND TRIM(l_override) IS NOT NULL THEN
                        BEGIN
                            l_company_id := TO_NUMBER(TRIM(l_override));
                        EXCEPTION
                            WHEN OTHERS THEN l_company_id := NULL;
                        END;
                    ELSE
                        -- Normal user: their own company
                        -- Super user with no override: NULL (no logo shown)
                        BEGIN
                            SELECT company_id
                            INTO   l_company_id
                            FROM   ptw_pro.ptw_lv_users
                            WHERE  UPPER(username) = UPPER(:APP_USER)
                            AND    is_super_user   = 'N'
                            AND    is_active       = 'Y';
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN l_company_id := NULL;
                        END;
                    END IF;
                 
                    -- Check if a logo file exists for this company
                    -- (graceful fallback - no broken image if file missing)
                 
                    IF l_company_id IS NOT NULL THEN
                        SELECT COUNT(*) INTO l_logo_count
                        FROM   apex_application_static_files
                        WHERE  application_id = :APP_ID
                        AND    file_name      = 'logo_' || l_company_id || '.png';
                 
                        IF l_logo_count > 0 THEN
                            l_logo_url := V('APP_FILES') || 'logo_' || l_company_id || '.png';
                        END IF;
                    END IF;
                 
                    -- Build header
                    l_html := '<div style="margin-bottom:30px;display:flex;'
                           || 'justify-content:space-between;align-items:center;'
                           || 'min-height:80px;">'
                           || '  <div>'
                           || '    <h1 style="font-size:2rem;color:#13294b;'
                           || '               margin-bottom:5px;">'
                           || '      New Dynamic Risk Assessment'
                           || '    </h1>'
                           || '    <p style="color:#666;font-size:1rem;">'
                           || '      Step 1 of 3 - Site &amp; Assessment Details'
                           || '    </p>'
                           || '  </div>';
                 
                    IF l_logo_url IS NOT NULL THEN
                        l_html := l_html
                               || '  <div style="width:200px;height:60px;display:flex;'
                               || 'align-items:center;justify-content:flex-end;">'
                               || '    <img src="' || l_logo_url || '" '
                               || '         alt="Company Logo" '
                               || '         style="max-width:100%;max-height:100%;'
                               || 'object-fit:contain;" />'
                               || '  </div>';
                    END IF;
                 
                    l_html := l_html || '</div>';
                 
                    RETURN l_html;
                 
                EXCEPTION
                    WHEN OTHERS THEN
                        -- Never break Page 12 - fall back to plain header
                        RETURN '<div style="margin-bottom:30px;">'
                            || '<h1 style="font-size:2rem;color:#13294b;">'
                            || 'New Dynamic Risk Assessment</h1>'
                            || '<p style="color:#666;">Step 1 of 3 - Site &amp; '
                            || 'Assessment Details</p></div>';
                END;
                
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P12_CHECKLIST_JSON (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            slot: body
        }
    )

    pageItem P12_DRA_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            slot: body
        }
    )

    pageItem P12_DRA_NUMBER (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            slot: body
        }
    )

    pageItem P12_DRA_TYPE (
        type: radioGroup
        label {
            label: Type of DRA
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Engineer DRA;ENGINEER,Subcontractor DRA;SUBCONTRACTOR
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @assessment-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: ENGINEER
        }
        readOnly {
            type: itemIsNotNull
            item: P12_DRA_ID
        }
    )

    pageItem P12_ENGINEER_NAME (
        type: textField
        label {
            label: Engineer Name
            alignment: left
        }
        layout {
            sequence: 40
            region: @assessment-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_name ptw_pro.ptw_lv_users.first_name%TYPE;
                    v_last ptw_pro.ptw_lv_users.last_name%TYPE;
                BEGIN
                    SELECT first_name, last_name
                    INTO   v_name, v_last
                    FROM   ptw_pro.ptw_lv_users
                    WHERE  UPPER(username) = UPPER(:APP_USER);
                    RETURN v_name || ' ' || v_last;
                EXCEPTION
                    WHEN OTHERS THEN RETURN NULL;
                END;
                ```
        }
    )

    pageItem P12_IS_CHANGED (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            slot: body
        }
    )

    pageItem P12_PERMIT_ID (
        type: popupLov
        label {
            label: Related Permit (optional)
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT permit_number || ' - ' || work_description d,
                       permit_id r
                FROM   ptw_pro.ptw_lv_permits
                WHERE  workflow_status NOT IN ('CLOSED','CANCELLED')
                ORDER BY created_date DESC
                ```
            displayExtraValues: false
            nullDisplayValue: -- Select permit --
        }
        layout {
            sequence: 60
            region: @assessment-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P12_SITE_DETAILS (
        type: textarea
        label {
            label: Task and Work Location Details
            alignment: left
        }
        layout {
            sequence: 30
            region: @assessment-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P12_SITE_ID (
        type: popupLov
        label {
            label: Site
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT site_name d, site_id r
                FROM   ptw_pro.ptw_lv_sites
                ORDER BY site_name
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 20
            region: @assessment-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P12_SUPERVISING_COMPANY (
        type: textField
        label {
            label: Subcontractor Company
            alignment: left
        }
        layout {
            sequence: 50
            region: @assessment-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: item=value
            item: P12_DRA_TYPE
            value: SUBCONTRACTOR
        }
    )

    pageItem P12_WORKFLOW_STATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            slot: body
        }
        default {
            type: static
            staticValue: DRAFT
        }
    )

    button new (
        buttonName: BACK
        label: Back
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: 11
            }
        }
    )

    button next-step (
        buttonName: NEXT_STEP
        label: Next Step
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-arrow-right
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button save-draft (
        buttonName: SAVE_DRAFT
        label: Save Draft
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction get-location-and-next-step (
        name: Get Location and Next Step
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @next-step
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.item('P12_CHECKLIST_JSON').setValue(JSON.stringify(PTW.dra.collect()));
                    captureLocationThenSubmit('NEXT_STEP');
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction get-location-and-save-draft (
        name: Get Location and Save Draft
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @save-draft
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.item('P12_CHECKLIST_JSON').setValue(JSON.stringify(PTW.dra.collect()));
                    captureLocationThenSubmit('SAVE_DRAFT');
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction load-checklists (
        name: Load checklists
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: ptwToggleSupervisingCompany();
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction toggle-subcontractor-field (
        name: Toggle Subcontractor Field
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P12_DRA_TYPE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: ptwToggleSupervisingCompany();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process load-dra-header-data (
        name: Load DRA Header Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    SELECT dra_number, dra_type, site_id, site_details, job_number,
                           engineer_name, supervising_company, permit_id, workflow_status
                    INTO   :P12_DRA_NUMBER, :P12_DRA_TYPE, :P12_SITE_ID, :P12_SITE_DETAILS,
                           :P12_JOB_NUMBER, :P12_ENGINEER_NAME, :P12_SUPERVISING_COMPANY,
                           :P12_PERMIT_ID, :P12_WORKFLOW_STATUS
                    FROM   ptw_pro.ptw_lv_dra_assessments
                    WHERE  dra_id = :P12_DRA_ID;
                 
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        apex_error.add_error(
                            p_message          => 'DRA not found.',
                            p_display_location => apex_error.c_inline_in_notification
                        );
                        apex_util.redirect_url(apex_page.get_url(p_page => 11));
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 43995088693819450
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P12_DRA_ID
        }
    )

    process save-dra-header (
        name: Save DRA Header
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_dra_id      ptw_pro.ptw_lv_dra_assessments.dra_id%TYPE := :P12_DRA_ID;
                    v_dra_number  ptw_pro.ptw_lv_dra_assessments.dra_number%TYPE;
                    v_saved       BOOLEAN;
                    v_message     VARCHAR2(4000);
                BEGIN
                    ptw_pro.ptw_dra_pkg.save_dra_header(
                        p_dra_id              => v_dra_id,
                        p_dra_type            => :P12_DRA_TYPE,
                        p_workflow_status     => :P12_WORKFLOW_STATUS,
                        p_site_id             => :P12_SITE_ID,
                        p_site_details        => :P12_SITE_DETAILS,
                        p_job_number          => :P12_JOB_NUMBER,
                        p_engineer_name       => :P12_ENGINEER_NAME,
                        p_supervising_company => :P12_SUPERVISING_COMPANY,
                        p_permit_id           => :P12_PERMIT_ID,
                        p_latitude            => TO_NUMBER(:APP_LATITUDE),
                        p_longitude           => TO_NUMBER(:APP_LONGITUDE),
                        p_dra_number          => v_dra_number,
                        p_saved               => v_saved,
                        p_message             => v_message
                    );
                
                    IF v_saved THEN
                        :P12_DRA_ID          := v_dra_id;
                        :P12_DRA_NUMBER      := v_dra_number;
                        :P12_WORKFLOW_STATUS := 'DRAFT';
                        apex_application.g_print_success_message := v_message;
                    ELSE
                        apex_error.add_error(
                            p_message          => v_message,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                        RAISE_APPLICATION_ERROR(-20083, v_message);
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 44028809410628809
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST IN ('SAVE_DRAFT','NEXT_STEP')
        }
    )

    branch (
        name: Go to Hazards & Controls
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 13
                items: {
                    P13_DRA_ID: &P12_DRA_ID.
                    P13_DRA_NUMBER: &P12_DRA_NUMBER.
                    P13_WORKFLOW_STATUS: &P12_WORKFLOW_STATUS.
                }
                clearCache: 13
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @next-step
        }
    )

    branch (
        name: Refresh Current Page (SAVE_DRAFT)
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 12
                clearCache: 12
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @save-draft
        }
    )

)

