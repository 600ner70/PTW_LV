        label: Back
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: BTN_BACK_P10
        }
    )

    button save-draft (
        buttonName: SAVE_DRAFT
        label: Save Draft
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
        advanced {
            htmlDomId: BTN_SAVE_DRAFT_P10
        }
        serverSideCondition {
            type: item=value
            item: P10_MONITORING_STATUS
            value: IN_PROGRESS
        }
    )

    button save-monitoring (
        buttonName: SAVE_MONITORING
        label: Save Monitoring
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: BTN_SAVE_MONITORING_P10
        }
        serverSideCondition {
            type: item=value
            item: P10_MONITORING_STATUS
            value: IN_PROGRESS
        }
    )

    dynamicAction check-1-not-in-order (
        name: Check 1 not in Order
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P10_MS_CHECK1_IN_ORDER
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var checkValue = apex.item('P10_MS_CHECK1_IN_ORDER').getValue();
                    
                    if (checkValue === 'N') {
                        apex.server.process('GET_CONCERN_DIALOG_URL', {
                            x01: apex.item('P10_PERMIT_ID').getValue(),
                            x02: apex.item('P10_PERMIT_NUMBER').getValue(),
                            x03: apex.item('P10_MONITORING_ID').getValue(),
                            x04: '1'
                        }, {
                            success: function (data) {
                                apex.item('P10_MONITORING_ID').setValue(data.monitoringId, null, true);
                    
                                apex.navigation.dialog(
                                    data.url,
                                    {
                                        title: 'Concern - Check 1 Not In Order',
                                        height: '650',
                                        width: '550',
                                        modal: true
                                    },
                                    '',
                                    $('#P10_MS_CHECK1_IN_ORDER')
                                );
                            }
                        });
                    } else if (checkValue === 'Y') {
                        apex.server.process('CHECK_CONCERN_EXISTS', {
                            x01: apex.item('P10_MONITORING_ID').getValue(),
                            x02: '1'
                        }, {
                            dataType: 'text',
                            success: function (data) {
                                if (data === 'Y') {
                                    apex.message.confirm(
                                        'This will delete the concern information already added for this check. Is this OK?',
                                        function (okPressed) {
                                            if (okPressed) {
                                                apex.server.process('DELETE_MONITORING_CONCERN', {
                                                    x01: apex.item('P10_MONITORING_ID').getValue(),
                                                    x02: '1'
                                                }, {
                                                    success: function () {
                                                        apex.message.showPageSuccess('Concern information removed.');
                                                    }
                                                });
                                            } else {
                                                apex.item('P10_MS_CHECK1_IN_ORDER').setValue('N');
                                            }
                                        }
                                    );
                                }
                            }
                        });
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

