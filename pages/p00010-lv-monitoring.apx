    validation at-least-one-method-statement-check (
        name: At Least One Method Statement Check
        execution {
            sequence: 40
        }
        validation {
            plsqlExpression: :P10_MS_CHECK1_DETAIL IS NOT NULL
        }
        error {
            errorMessage: At least one method statement compliance check (Check 1) is required.
            associatedItem: @P10_MS_CHECK1_DETAIL
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'SAVE_MONITORING'
        }
    )

    validation at-least-one-site-check-answered (
        name: At Least One Site Check Answered
        execution {
            sequence: 30
        }
        validation {
            plsqlExpression:
                ```plsql
                :P10_CHK_PERMIT_ON_DISPLAY IS NOT NULL
                OR :P10_CHK_ACCESS_EGRESS  IS NOT NULL
                OR :P10_CHK_WARNING_SIGNS  IS NOT NULL
                ```
        }
        error {
            errorMessage: Please complete at least one site monitoring check.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'SAVE_MONITORING'
        }
    )

    validation check-in-order (
        name: Check in order
        execution {
            sequence: 50
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_unresolved NUMBER;
                BEGIN
                    SELECT COUNT(*)
                    INTO   l_unresolved
                    FROM   (SELECT 1 AS check_number FROM dual WHERE :P10_MS_CHECK1_IN_ORDER = 'N'
                            UNION ALL
                            SELECT 2 FROM dual WHERE :P10_MS_CHECK2_IN_ORDER = 'N'
                            UNION ALL
                            SELECT 3 FROM dual WHERE :P10_MS_CHECK3_IN_ORDER = 'N') failing
                    WHERE NOT EXISTS (
                        SELECT 1
                        FROM   ptw_pro.ptw_lv_monitoring_concerns mc
                        WHERE  mc.monitoring_id     = :P10_MONITORING_ID
                        AND    mc.check_number      = failing.check_number
                        AND    mc.happy_to_continue IS NOT NULL
                        AND    mc.concern_signature IS NOT NULL
                    );
                
                    RETURN l_unresolved = 0;
                END;
                ```
        }
        error {
            errorMessage: One or more checks marked 'not in order' still need their concern signed off before this monitoring visit can be completed.
        }
        serverSideCondition {
            whenButtonPressed: @save-monitoring
        }
    )

