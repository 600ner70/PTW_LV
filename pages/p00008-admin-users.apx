    process clear-password-fields-after-submit (
        name: Clear Password Fields After Submit
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P8_PASSWORD             := NULL;
                    :P8_CONFIRM_PASSWORD     := NULL;
                    :P8_NEW_PASSWORD         := NULL;
                    :P8_CONFIRM_NEW_PASSWORD := NULL;
                END;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 31605021950440612
        }
        serverSideCondition {
            type: expression
