page 24 (
    name: Edit Company
    alias: EDIT-COMPANY
    title: Add/Edit Company
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            (function () {
                var BINARY_ITEMS = ['P24_IS_ACTIVE'];
            
                var BADGES = [
                    { val: 'Y', cls: 'binary-badge-yes', label: '✓' },
                    { val: 'N', cls: 'binary-badge-no',  label: '✗' }
                ];
            
                BINARY_ITEMS.forEach(function (itemName) {
                    var $fc = $('#' + itemName).closest('.t-Form-fieldContainer');
                    if ($fc.length === 0) return;
            
                    $fc.find('.binary-badge-row').remove();
            
                    var currentVal = $('input[name="' + itemName + '"]:checked').val() || '';
            
                    var $row = $('<div class="binary-badge-row"></div>').attr('data-item', itemName);
            
                    BADGES.forEach(function (b) {
                        $('<span></span>')
                            .addClass('binary-badge ' + b.cls)
                            .toggleClass('cm-active', currentVal === b.val)
                            .attr('data-value', b.val)
                            .text(b.label)
                            .appendTo($row);
                    });
            
                    $fc.find('.t-Form-inputContainer').append($row);
                });
            
                $('.cm-binary-item .apex-item-grid').hide();
            
                $(document).off('click.binarybadge24').on('click.binarybadge24', '.binary-badge:not(.binary-readonly)', function () {
                    var $badge   = $(this);
                    var $row     = $badge.closest('.binary-badge-row');
                    var itemName = $row.attr('data-item');
                    var val      = $badge.attr('data-value');
            
                    $('input[name="' + itemName + '"][value="' + val + '"]')
                        .prop('checked', true).trigger('change');
            
                    $row.find('.binary-badge').removeClass('cm-active');
                    $badge.addClass('cm-active');
                });
            }());
            ```
    }
    security {
        authorizationScheme: @super-user-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region company-details (
        name: Company Details
        title: Company Details
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P24_COMPANY_CODE (
        type: textField
        label {
            label: Company Code
            alignment: left
        }
        layout {
            sequence: 20
            region: @company-details
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: style="text-transform:uppercase"
        }
        readOnly {
            type: itemIsNotNull
            item: P24_COMPANY_ID
        }
    )

    pageItem P24_COMPANY_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P24_COMPANY_NAME (
        type: textField
        label {
            label: Company Name
            alignment: left
        }
        layout {
            sequence: 10
            region: @company-details
            slot: regionBody
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: itemIsNotNull
            item: P24_COMPANY_ID
        }
    )

    pageItem P24_CREATED_DATE (
        type: displayOnly
        label {
            label: Date Created
            alignment: left
        }
        layout {
            sequence: 70
            region: @company-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: DD-MON-YYYY HH24:MI
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P24_COMPANY_ID
        }
    )

    pageItem P24_HEADER_TEXT (
        type: textField
        label {
            label: Header Text
            alignment: left
        }
        layout {
            sequence: 60
            region: @company-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P24_IS_ACTIVE (
        type: radioGroup
        label {
            label: Active?
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Yes;Y,No;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @company-details
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            cssClasses: cm-binary-item
        }
        default {
            type: static
            staticValue: Y
        }
    )

    pageItem P24_PERMIT_PREFIX (
        type: textField
        label {
            label: Permit Number Prefix
            alignment: left
        }
        layout {
            sequence: 30
            region: @company-details
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: e.g. MWM
        }
        validation {
            maxLength: 4
        }
        serverSideCondition {
            type: itemIsNull
            item: P24_COMPANY_ID
        }
    )

    pageItem P24_PERMIT_PREFIX_DISPLAY (
        type: displayOnly
        label {
            label: Permit Prefix Display
            alignment: left
        }
        layout {
            sequence: 40
            region: @company-details
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        advanced {
            customAttributes: style="text-transform:uppercase"
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P24_COMPANY_ID
        }
    )

    pageItem P24_USER_COUNT (
        type: displayOnly
        label {
            label: Users in this Company
            alignment: left
        }
        layout {
            sequence: 80
            region: @company-details
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT COUNT(*) 
                FROM   ptw_pro.ptw_lv_users
                WHERE  company_id = :P24_COMPANY_ID
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P24_COMPANY_ID
        }
        help {
            inlineHelpText: Informational only - helps super user judge whether a company can safely be deleted
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 21
                clearCache: 21
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: BTN_CANCEL_P24
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 10
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: BTN_SAVE_P24
        }
    )

    validation company-code-must-be-unique (
        name: Company Code Must Be Unique
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_count NUMBER;
                BEGIN
                    -- company_code has a UNIQUE constraint but is nullable;
                    -- NULLs don't violate uniqueness, so only check when a
                    -- value is actually entered.
                    IF :P24_COMPANY_CODE IS NULL THEN
                        RETURN TRUE;
                    END IF;
                
                    SELECT COUNT(*) INTO v_count
                    FROM   ptw_pro.ptw_lv_companies
                    WHERE  UPPER(company_code) = UPPER(:P24_COMPANY_CODE)
                    AND    (company_id != :P24_COMPANY_ID OR :P24_COMPANY_ID IS NULL);
                    RETURN v_count = 0;
                END;
                ```
        }
        error {
            errorMessage: This Company Code is already in use by another company. Please choose a different code, or leave it blank.
            associatedItem: @P24_COMPANY_CODE
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation company-name-required (
        name: Company Name Required
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P24_COMPANY_NAME
        }
        error {
            errorMessage: Company Name is required.
            associatedItem: @P24_COMPANY_NAME
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation prefix-must-be-unique (
        name: Prefix Must Be Unique
        execution {
            sequence: 40
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_count NUMBER;
                BEGIN
                    -- Only validate in create mode
                    IF :P24_COMPANY_ID IS NOT NULL THEN
                        RETURN TRUE;
                    END IF;
                
                    SELECT COUNT(*) INTO v_count
                    FROM   ptw_pro.ptw_lv_companies
                    WHERE  UPPER(permit_prefix) = UPPER(TRIM(:P24_PERMIT_PREFIX));
                
                    RETURN v_count = 0;
                END;
                ```
        }
        error {
            errorMessage: This prefix is already used by another company. Please choose a different one.
            associatedItem: @P24_PERMIT_PREFIX
        }
    )

    validation prefix-required-and-valid (
        name: Prefix Required and Valid
        execution {
            sequence: 30
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_prefix VARCHAR2(4) := TRIM(:P24_PERMIT_PREFIX);
                BEGIN
                    -- Only validate in create mode (item is hidden on edit)
                    IF :P24_COMPANY_ID IS NOT NULL THEN
                        RETURN TRUE;
                    END IF;
                
                    RETURN v_prefix IS NOT NULL
                       AND LENGTH(v_prefix) BETWEEN 1 AND 4
                       AND UPPER(v_prefix) = v_prefix;
                END;
                ```
        }
        error {
            errorMessage: Permit Number Prefix is required and must be 1-4 uppercase letters (e.g. MWM).
            associatedItem: @P24_PERMIT_PREFIX
        }
    )

    process fetch-company (
        name: Fetch Company
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    --
                    SELECT c.company_name,
                           c.company_code,
                           c.permit_prefix,
                           c.is_active,
                           c.header_text,
                           TO_CHAR(c.created_date, 'DD-MON-YYYY') AS created_date,
                           (SELECT COUNT(*) FROM ptw_pro.ptw_lv_users u
                             WHERE u.company_id = c.company_id)   AS user_count
                    INTO   :P24_COMPANY_NAME,
                           :P24_COMPANY_CODE,
                           :P24_PERMIT_PREFIX_DISPLAY,
                           :P24_IS_ACTIVE,
                           :P24_HEADER_TEXT,
                           :P24_CREATED_DATE,
                           :P24_USER_COUNT
                    FROM   ptw_pro.ptw_lv_companies c
                    WHERE  company_id = :P24_COMPANY_ID
                    ORDER  BY c.company_name;
                END;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 52416338328182127
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P24_COMPANY_ID
        }
    )

    process save-company (
        name: Save Company
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :P24_COMPANY_ID IS NOT NULL THEN
                
                    DECLARE
                        l_db_comp_is_active VARCHAR2(1);
                    BEGIN
                        --
                        SELECT is_active
                        INTO   l_db_comp_is_active
                        FROM   ptw_pro.ptw_lv_companies
                        WHERE  company_id = :P24_COMPANY_ID;
                        --
                        IF l_db_comp_is_active != :P24_IS_ACTIVE THEN
                            --
                            UPDATE ptw_pro.ptw_lv_companies
                            SET    is_active = :P24_IS_ACTIVE
                            WHERE  company_id = :P24_COMPANY_ID;
                        END IF;
                    END;
                
                ELSE
                
                    INSERT INTO ptw_pro.ptw_lv_companies
                        (company_name, company_code, is_active, permit_prefix, header_text)
                    VALUES (
                        :P24_COMPANY_NAME,
                        :P24_COMPANY_CODE,
                        :P24_IS_ACTIVE,
                        :P24_PERMIT_PREFIX,
                        :P24_HEADER_TEXT
                    );
                
                END IF;
                
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 52416461002182128
        }
    )

    branch (
        name: Return to Page 21
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 21
                clearCache: 21
                successMessage: false
            }
        }
    )

)

