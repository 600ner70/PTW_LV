            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    captureLocationThenSubmit('NEXT_STEP');
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P3_IS_CHANGED
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

