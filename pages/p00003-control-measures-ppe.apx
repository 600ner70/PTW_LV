    process load-control-measures-and-ppe-data (
        name: Load Control Measures and PPE Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    -- Load permit info (PPE columns)
                    :P3_CURRENT_STEP := 'CONTROL_MEASURES';
                    SELECT
                        permit_number,
                        workflow_status,
                        ptw_type
                    INTO
                        :P3_PERMIT_NUMBER,
                        :P3_WORKFLOW_STATUS,
                        :P3_PTW_TYPE
                    FROM ptw_pro.ptw_lv_permits
                    WHERE permit_id = :P3_PERMIT_ID;
                
                    :G_ACTIVE_PERMIT_ID := :P3_PERMIT_ID;
                
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        apex_error.add_error(
                            p_message => 'Permit not found.',
                            p_display_location => apex_error.c_inline_in_notification
                        );
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 27016141402886512
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_PERMIT_ID
        }
    )

    process save-control-measures-and-ppe-data (
        name: Save Control Measures and PPE Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  IF :P3_WORKFLOW_STATUS = 'DRAFT' THEN
                    ptw_pro.ptw_checklist_pkg.save_checklist_responses(:P3_PERMIT_ID, :P3_CHECKLIST_JSON);
                  END IF;
                
                EXCEPTION
                    WHEN OTHERS THEN
                        ROLLBACK;
                        apex_error.add_error(
                            p_message          => 'Error saving control measures: ' || SQLERRM,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                        RAISE;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Control measures and PPE saved successfully.
        }
        advanced {
            executionMappingIdentifier: 27016268704886513
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST IN ('SAVE_DRAFT','NEXT_STEP')
        }
        security {
            authorizationScheme: @can-edit-permits
        }
    )

    branch (
        name: Go to Authorisation & Acceptance
        execution {
            sequence: 30
        }
        behavior {
            target: {
