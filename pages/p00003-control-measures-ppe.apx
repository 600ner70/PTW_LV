    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 150
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region control-measures-checklist (
        name: Control Measures Checklist
        title: Control Measures - must be in place before issuing a Permit to Work LV Electrical
        type: staticContent
        layout {
            sequence: 130
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent15
                t-Region--scrollBody
            ]
            icon: fa-clipboard-check
        }
    )

    region permit-information-badge (
        name: Permit Information Badge
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="margin-bottom: 20px;">
                    <span class="apex-badge" style="background-color: #3ea055; color: white; padding: 6px 16px; border-radius: 20px; font-weight: 600;">
                        Permit: &P3_PERMIT_NUMBER.
                    </span>
                </div>
                
                ```
        }
        layout {
            sequence: 120
            slot: body
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_PERMIT_NUMBER
        }
    )

    region ppe-requirements (
        name: PPE Requirements
        title: Identify Essential Personal Protective Equipment (PPE) Required To Be Worn
        type: staticContent
        layout {
