    validation all-control-measures-must-be-confirmed (
        name: All Control Measures Must Be Confirmed
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_unanswered_count NUMBER;
                BEGIN
                    SELECT COUNT(*)
                    INTO   l_unanswered_count
                    FROM   ptw_pro.ptw_checklist_items ci
                    JOIN   ptw_pro.ptw_types t         ON t.type_id = ci.type_id
                    JOIN   ptw_pro.ptw_lv_permits p    ON p.ptw_type = t.ptw_type
                    WHERE  p.permit_id  = :P3_PERMIT_ID
                    AND    ci.is_active = 'Y'
                    AND    ci.section_code = 'CONTROL_MEASURES'
                    AND    NOT EXISTS (
                        SELECT 1
                        FROM   JSON_TABLE(:P3_CHECKLIST_JSON, '$[*]'
                                   COLUMNS (
                                       checklist_item_id NUMBER      PATH '$.checklist_item_id',
                                       response          VARCHAR2(2) PATH '$.response'
                                   )) jt
                        WHERE  jt.checklist_item_id = ci.checklist_item_id
                        AND    jt.response IS NOT NULL
                    );
                
                    RETURN l_unanswered_count = 0;
                END;
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: All control measures must be confirmed before proceeding to the next step.
        }
        serverSideCondition {
            type: request=Value
            value: NEXT_STEP
        }
    )

    validation permit-id-required (
        name: Permit ID Required
        execution {
            sequence: 10
