    dynamicAction authorisors-mobile-no-load (
        name: Authorisors mobile No load
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: P5_AUTH_PERSON_SELECT
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        SELECT first_name||' '||last_name, mobile_no
                        INTO   :P5_AUTH_PERSON_DISPLAY, :P5_AUTH_PERSON_MOBILE
                        FROM   ptw_pro.ptw_lv_users
                        WHERE  UPPER(username) = UPPER(:P5_AUTH_PERSON_SELECT);
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN NULL;
                    END;
                    ```
                itemsToSubmit: P5_AUTH_PERSON_SELECT
                itemsToReturn: P5_AUTH_PERSON_MOBILE
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction click-the-authorise-button (
