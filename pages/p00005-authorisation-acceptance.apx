    button back (
        buttonName: BACK
        label: Back
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 4
                items: {
                    P4_PERMIT_ID: &P5_PERMIT_ID.
                }
                clearCache: 4
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: BTN_BACK_P5
