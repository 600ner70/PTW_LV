    validation permit-still-valid (
        name: Permit Still Valid
        execution {
            sequence: 50
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_count NUMBER;
                BEGIN
                    SELECT COUNT(*)
                    INTO   v_count
                    FROM   ptw_pro.ptw_lv_permits
                    WHERE  permit_id       = :P16_PERMIT_ID
                    AND    workflow_status = 'STARTED'
                    AND    SYSDATE         < ended_datetime;
                    RETURN v_count > 0;
                END;
                ```
        }
        error {
            errorMessage: Permit can no longer be cleared — it may have expired or already been closed.
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @clear-permit
        }
    )

