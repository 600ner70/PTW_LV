        }
        layout {
            sequence: 60
            slot: contentBody
        }
    )

    pageItem P16_WORKFLOW_STATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button clear-permit (
        buttonName: CLEAR_PERMIT
        label: &P16_CLEAR_BUTTON_LABEL.
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check-circle
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: BTN_CLEAR_PERMIT_P16
        }
    )

    dynamicAction cancel-close-dialog (
        name: Cancel - Close Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction clear-permit-capture-location-and-submit (
        name: Clear Permit - Capture Location and Submit
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @clear-permit
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: captureLocationThenSubmit('CLEAR_PERMIT');
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation area-safe-required (
        name: Area Safe Required
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P16_CLEAR_AREA_SAFE
        }
        error {
            errorMessage: Please indicate whether it is safe to reinstate plant and equipment.
        }
        serverSideCondition {
            whenButtonPressed: @clear-permit
        }
    )

    validation engineers-signature-required (
        name: Engineers signature required
        execution {
            sequence: 50
        }
        validation {
            type: itemIsNotNull
            item: P16_CLEAR_ENG_SIGNATURE_DATA
        }
        error {
            errorMessage: A signature is required from the Engineer to clear the permit.
        }
        serverSideCondition {
            whenButtonPressed: @clear-permit
            type: item=value
            item: P16_PTW_TYPE
            value: GENERAL
        }
    )

    validation hot-work-fire-watch-must-be-complete (
        name: Hot Work Fire Watch Must Be Complete
        execution {
            sequence: 80
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                            DECLARE
                                l_count NUMBER;
                            BEGIN
                                IF :P16_PTW_TYPE != 'HOT WORK' THEN
                                    RETURN TRUE;
                                END IF;
                
                                SELECT COUNT(*) INTO l_count
                                FROM   ptw_pro.ptw_hotwork_fire_watch
                                WHERE  permit_id = :P16_PERMIT_ID
                                AND    milestone_code = 'FIRE_CHECKS_COMPLETE';
                
                                RETURN l_count > 0;
                            END;
                ```
        }
        error {
            errorMessage: All fire watch checks must be signed off before this permit can be cleared.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'CLEAR_PERMIT' AND :P16_PTW_TYPE = 'HOT WORK'
        }
    )

    validation isolations-removed-required (
        name: Isolations Removed Required
        execution {
            sequence: 70
        }
        validation {
            type: itemIsNotNull
            item: P16_CLEAR_ISOLATIONS_REMOVED
        }
        error {
            errorMessage: Please indicate whether personal isolations have been removed.
        }
        serverSideCondition {
            whenButtonPressed: @clear-permit
            type: item=value
            item: P16_PTW_TYPE
            value: GENERAL
        }
    )

    validation permit-still-valid (
        name: Permit Still Valid
        execution {
            sequence: 60
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_count NUMBER;
                BEGIN
                    SELECT COUNT(*)
                    INTO   v_count
                    FROM   ptw_pro.ptw_lv_permits
                    WHERE  permit_id       = :P16_PERMIT_ID
                    AND    workflow_status = 'STARTED'
                    AND    SYSDATE         < ended_datetime;
                    RETURN v_count > 0;
                END;
                ```
        }
        error {
            errorMessage: Permit can no longer be cleared — it may have expired or already been closed.
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @clear-permit
        }
    )

    validation person-name-required (
        name: Person Name Required
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P16_CLEAR_PERSON_NAME
        }
        error {
            errorMessage: Name of Person in Charge is required.
        }
        serverSideCondition {
            whenButtonPressed: @clear-permit
        }
    )

    validation signature-required (
        name: Signature Required
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P16_CLEAR_SIGNATURE_DATA
        }
        error {
            errorMessage: A signature is required to clear the permit.
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @clear-permit
        }
    )

    validation work-complete-required (
        name: Work Complete Required
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P16_CLEAR_WORK_COMPLETE
        }
        error {
            errorMessage: Please indicate whether the works are completed or not complete.
        }
        serverSideCondition {
            whenButtonPressed: @clear-permit
        }
    )

    process clear-permit (
        name: Clear Permit
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_sig_blob  BLOB;
                    v_clob      CLOB;
                    v_now       DATE := SYSDATE;
                BEGIN
                    IF :P16_CLEAR_SIGNATURE_DATA IS NOT NULL THEN
                        v_clob     := REPLACE(:P16_CLEAR_SIGNATURE_DATA, 'data:image/png;base64,', '');
                        v_sig_blob := apex_web_service.clobbase642blob(v_clob);
                    END IF;
                
                    -- Guarded status transition stays on PTW_LV_PERMITS, same race-condition
                    -- protection as before (workflow_status/expiry check + ROWCOUNT).
                    UPDATE ptw_pro.ptw_lv_permits
                    SET    clear_work_complete = :P16_CLEAR_WORK_COMPLETE,
                           clear_area_safe     = :P16_CLEAR_AREA_SAFE,
                           clear_isolations_removed = :P16_CLEAR_ISOLATIONS_REMOVED,
                           clear_system_reactivated = :P16_CLEAR_SYSTEM_REACTIVATED,
                           workflow_status     = 'COMPLETED',
                           current_step        = 'CLEARANCE',
                           clear_latitude      = TO_NUMBER(:APP_LATITUDE),
                           clear_longitude     = TO_NUMBER(:APP_LONGITUDE),
                           completion_date     = v_now,
                           modified_by         = V('APP_USER'),
                           modified_date       = v_now
                    WHERE  permit_id           = :P16_PERMIT_ID
                    AND    workflow_status     = 'STARTED'
                    AND    SYSDATE             < ended_datetime;
                
                    IF SQL%ROWCOUNT = 0 THEN
                        RAISE_APPLICATION_ERROR(-20001,
                            'Permit could not be cleared. It may have expired or '
                            || 'already been closed. Please refresh the permits list.');
                    END IF;
                
                    ptw_pro.ptw_signature_pkg.save_signature(
                        p_permit_id      => :P16_PERMIT_ID,
                        p_stage          => 'CLEAR',
                        p_person_name    => UPPER(TRIM(:P16_CLEAR_PERSON_NAME)),
                        p_signature_blob => v_sig_blob,
                        p_mobile_no      => TRIM(:P16_CLEAR_PERSON_MOBILE),
                        p_company_name   => UPPER(TRIM(:P16_CLEAR_COMPANY)),
                        p_event_datetime => v_now,
                        p_latitude       => TO_NUMBER(:APP_LATITUDE),
                        p_longitude      => TO_NUMBER(:APP_LONGITUDE)
                    );
                
                    IF :P16_CLEAR_ENG_SIGNATURE_DATA IS NOT NULL OR :P16_CLEAR_ENG_PERSON_NAME IS NOT NULL THEN
                        DECLARE
                            v_eng_sig_blob BLOB;
                            v_eng_clob     CLOB;
                        BEGIN
                            IF :P16_CLEAR_ENG_SIGNATURE_DATA IS NOT NULL THEN
                                v_eng_clob     := REPLACE(:P16_CLEAR_ENG_SIGNATURE_DATA, 'data:image/png;base64,', '');
                                v_eng_sig_blob := apex_web_service.clobbase642blob(v_eng_clob);
                            END IF;
                
                            ptw_pro.ptw_signature_pkg.save_signature(
                                p_permit_id      => :P16_PERMIT_ID,
                                p_stage          => 'CLR_ENG',
                                p_person_name    => UPPER(TRIM(:P16_CLEAR_ENG_PERSON_NAME)),
                                p_signature_blob => v_eng_sig_blob,
                                p_event_datetime => v_now,
                                p_latitude       => TO_NUMBER(:APP_LATITUDE),
                                p_longitude      => TO_NUMBER(:APP_LONGITUDE)
                            );
                        END;
                    END IF;
                
                    COMMIT;
                    :P16_CLEARED := 'Y';
                    apex_application.g_print_success_message :=
                        'Permit ' || :P16_PERMIT_NUMBER || ' cleared successfully.';
                
                EXCEPTION
                    WHEN OTHERS THEN
                        ROLLBACK;
                        apex_error.add_error(
                            p_message          => 'Error clearing permit: ' || SQLERRM,
                            p_display_location => apex_error.c_inline_in_notification
                        );
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 45755480536782506
        }
        serverSideCondition {
            whenButtonPressed: @clear-permit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: P16_CLEARED
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 45755524966782507
        }
        serverSideCondition {
            type: item=value
            item: P16_CLEARED
            value: N
        }
    )

    process load-permit-data (
        name: Load Permit Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_status        VARCHAR2(20);
                    v_ended         DATE;
                    v_sig           BLOB;
                    v_eng_sig       BLOB;
                    v_na_lat        ptw_pro.ptw_signatures.latitude%TYPE;
                    v_na_lng        ptw_pro.ptw_signatures.longitude%TYPE;
                    v_na_mobile     ptw_pro.ptw_signatures.mobile_no%TYPE;
                    v_na_company    ptw_pro.ptw_signatures.company_name%TYPE;
                    v_na_dt         DATE;
                    v_na_auth_to_dt  ptw_pro.ptw_signatures.auth_to_datetime%TYPE; 
                BEGIN
                
                    SELECT workflow_status, ended_datetime, permit_number,
                           person_in_charge_name, supervising_company, ptw_type
                    INTO   v_status, v_ended, :P16_PERMIT_NUMBER,
                           :P16_CLEAR_PERSON_NAME, :P16_CLEAR_COMPANY, :P16_PTW_TYPE
                    FROM   ptw_pro.ptw_lv_permits
                    WHERE  permit_id = :P16_PERMIT_ID;
                
                    :P16_BANNER_TITLE := CASE WHEN :P16_PTW_TYPE = 'GENERAL'
                                              THEN 'Completion of Works'
                                              ELSE 'Clearance of Permit to Work'
                                         END;
                
                    :P16_CLEAR_BUTTON_LABEL := CASE WHEN :P16_PTW_TYPE = 'GENERAL'
                                                    THEN 'Complete'
                                                    ELSE 'Clear Permit'
                                               END;
                                               
                    IF v_status NOT IN ('STARTED', 'COMPLETED') THEN
                        apex_error.add_error(
                            p_message          => 'This permit cannot be viewed here. Current status: ' || v_status,
                            p_display_location => apex_error.c_on_error_page
                        );
                        RETURN;
                    END IF;
                
                    IF v_status = 'STARTED' THEN
                        IF SYSDATE >= v_ended THEN
                            apex_error.add_error(
                                p_message          => 'This permit has expired ('
                                                      || TO_CHAR(v_ended, 'DD-MON-YYYY HH24:MI')
                                                      || ') and cannot be cleared.',
                                p_display_location => apex_error.c_on_error_page
                            );
                            RETURN;
                        END IF;
                        :P16_CLEAR_DATETIME := TO_CHAR(SYSDATE, 'DD-MON-YYYY HH24:MI');
                    END IF;
                
                    IF v_status = 'COMPLETED' THEN
                        ptw_pro.ptw_signature_pkg.get_signature(:P16_PERMIT_ID, 'CLEAR',
                            :P16_CLEAR_PERSON_NAME, v_sig, :P16_CLEAR_PERSON_MOBILE, :P16_CLEAR_COMPANY,
                            :P16_CLEAR_DATETIME, v_na_lat, v_na_lng, v_na_auth_to_dt);
                
                        SELECT clear_work_complete, clear_area_safe,
                               clear_isolations_removed, clear_system_reactivated
                        INTO   :P16_CLEAR_WORK_COMPLETE, :P16_CLEAR_AREA_SAFE,
                               :P16_CLEAR_ISOLATIONS_REMOVED, :P16_CLEAR_SYSTEM_REACTIVATED
                        FROM   ptw_pro.ptw_lv_permits
                        WHERE  permit_id = :P16_PERMIT_ID;
                
                        IF v_sig IS NOT NULL AND DBMS_LOB.GETLENGTH(v_sig) > 0 THEN
                            :P16_CLEAR_SIGNATURE_DATA_URL := 'data:image/png;base64,'
                                || apex_web_service.blob2clobbase64(v_sig);
                        END IF;
                
                        IF :P16_PTW_TYPE = 'GENERAL' THEN
                            BEGIN
                                ptw_pro.ptw_signature_pkg.get_signature(:P16_PERMIT_ID, 'CLR_ENG',
                                    :P16_CLEAR_ENG_PERSON_NAME, v_eng_sig, v_na_mobile, v_na_company,
                                    v_na_dt, v_na_lat, v_na_lng, v_na_auth_to_dt);
                                IF v_eng_sig IS NOT NULL AND DBMS_LOB.GETLENGTH(v_eng_sig) > 0 THEN
                                    :P16_CLEAR_ENG_SIGNATURE_DATA_URL := 'data:image/png;base64,'
                                        || apex_web_service.blob2clobbase64(v_eng_sig);
                                END IF;
                            EXCEPTION
                                WHEN NO_DATA_FOUND THEN NULL; -- Engineer signature is optional
                            END;
                        END IF;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 45755388825782505
        }
    )

    branch (
        name: Back to Dashboard after saving
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 1
                clearCache: 1
                successMessage: false
            }
        }
        serverSideCondition {
            type: item=value
            item: P16_CLEARED
            value: Y
        }
    )

)

